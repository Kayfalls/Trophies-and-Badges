rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      // Allow public read
      allow read: if true;
      
      // TEMPORARY: Allow public write for testing/seeding phase
      // This matches the current firestore.rules logic
      allow write: if true;
      
      // Production-ready rule (commented out for now):
      // allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
